# Copy to .env and fill in real values. .env is gitignored.

# Stripe — use a TEST key (sk_test_...) for the PoC.
STRIPE_API_KEY=sk_test_REPLACE_ME

# Mailchimp — key suffix and DC must match (e.g. ...-us2 ↔ us2.api.mailchimp.com)
MAILCHIMP_API_KEY=REPLACE_ME-us2
MAILCHIMP_DC=us2
MAILCHIMP_LIST_ID=REPLACE_ME
MAILCHIMP_FROM_NAME=YourCompany
MAILCHIMP_REPLY_TO=hello@example.com

# Mandrill (transactional)
MANDRILL_API_KEY=REPLACE_ME
MANDRILL_FROM_EMAIL=hello@example.com
MANDRILL_TO_EMAIL=customer@example.com

# Stripe billing-portal demo
STRIPE_CUSTOMER_ID=cus_REPLACE_ME
STRIPE_PORTAL_CONFIG_ID=bpc_REPLACE_ME
STRIPE_PORTAL_RETURN_URL=https://example.com/account
